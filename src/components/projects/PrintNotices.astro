---
import { Alert, AlertDescription } from "@/components/ui/alert";
import { printNoticeMessage, type PrintNotice } from "@/lib/quote-print";
import { t } from "@/lib/i18n";
import { TriangleAlertIcon } from "lucide-react";

/** The printout's screen-only notices (override outdated, no company details, rate warning). They never print. */
interface Props {
  notices: readonly PrintNotice[];
}

const { notices } = Astro.props;
---

{notices.length > 0 && (
  <ul class="flex flex-col gap-2 print:hidden">
    {notices.map((notice) => (
      <li>
        <Alert variant="warning" role={undefined}>
          <TriangleAlertIcon aria-hidden="true" />
          <AlertDescription className="block">
            <strong>{t.common.warningPrefix}</strong> {printNoticeMessage(notice)}
          </AlertDescription>
        </Alert>
      </li>
    ))}
  </ul>
)}
