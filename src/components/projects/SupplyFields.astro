---
import { t } from "@/lib/i18n";
import {
  CONDUCTOR_MATERIALS,
  EARTHING_SYSTEMS,
  MAX_WLZ_LENGTH_M,
  PHASE_COUNTS,
  PREMETER_PROTECTIONS_A,
  SUPPLY_FIELDS,
  WLZ_CROSS_SECTIONS_MM2,
  WLZ_INSTALLATIONS,
  WLZ_LENGTH_INPUT_PATTERN,
  supplyOptionValue,
  type SupplyColumn,
  type SupplyFormDefaults,
} from "@/lib/supply-params";
import { cn } from "@/lib/utils";

/**
 * The OSD and WLZ inputs of the project page's supply form. Every `<option value>` goes through
 * `supplyOptionValue`, because `parseSupplyForm` matches the option strings exactly. An unset supply
 * selects an empty, disabled placeholder, so `required` really blocks a submit with nothing picked.
 */
interface Props {
  defaults: SupplyFormDefaults;
}

const { defaults } = Astro.props;

interface Choice {
  value: string;
  label: string;
}

interface SelectField {
  id: string;
  name: SupplyColumn;
  label: string;
  hint?: string;
  choices: Choice[];
}

function choices<T extends string | number>(list: readonly T[], label: (value: T) => string): Choice[] {
  return list.map((value) => ({ value: supplyOptionValue(value), label: label(value) }));
}

const osdFields: SelectField[] = [
  {
    id: "supply-protection",
    name: SUPPLY_FIELDS.premeterProtection,
    label: t.supply.fields.premeterProtection,
    hint: t.supply.protectionHint,
    choices: choices(PREMETER_PROTECTIONS_A, t.supply.protectionOption),
  },
  {
    id: "supply-earthing",
    name: SUPPLY_FIELDS.earthingSystem,
    label: t.supply.fields.earthingSystem,
    choices: choices(EARTHING_SYSTEMS, (value) => t.supply.earthingSystems[value]),
  },
  {
    id: "supply-phases",
    name: SUPPLY_FIELDS.phaseCount,
    label: t.supply.fields.phaseCount,
    choices: choices(PHASE_COUNTS, t.supply.phaseCountOption),
  },
];

const wlzFields: SelectField[] = [
  {
    id: "supply-cross-section",
    name: SUPPLY_FIELDS.wlzCrossSection,
    label: t.supply.fields.wlzCrossSection,
    hint: t.supply.crossSectionHint,
    choices: choices(WLZ_CROSS_SECTIONS_MM2, t.supply.crossSectionOption),
  },
  {
    id: "supply-material",
    name: SUPPLY_FIELDS.wlzMaterial,
    label: t.supply.fields.wlzMaterial,
    choices: choices(CONDUCTOR_MATERIALS, (value) => t.supply.materials[value]),
  },
  {
    id: "supply-installation",
    name: SUPPLY_FIELDS.wlzInstallation,
    label: t.supply.fields.wlzInstallation,
    choices: choices(WLZ_INSTALLATIONS, (value) => t.supply.installations[value]),
  },
];

const inputClass = cn(
  "w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/40",
  "transition-colors focus:ring-2 focus:ring-purple-400 focus:outline-none",
);
// Native option lists render on the OS's light popup; dark text keeps them readable there.
const optionClass = "text-slate-900";
const labelClass = "mb-1 block text-xs text-blue-100/80";
const hintClass = "mt-1 text-xs text-blue-100/50";
const legendClass = "mb-3 text-sm font-semibold";
---

<fieldset>
  <legend class:list={legendClass}>{t.supply.osdSection}</legend>
  <div class="grid gap-4 sm:grid-cols-3">
    {osdFields.map((field) => (
      <div>
        <label for={field.id} class:list={labelClass}>
          {field.label}
        </label>
        <select
          id={field.id}
          name={field.name}
          required
          aria-describedby={field.hint ? `${field.id}-hint` : undefined}
          class:list={inputClass}
        >
          <option value="" disabled selected={defaults[field.name] === ""} class:list={optionClass}>
            {t.supply.choose}
          </option>
          {field.choices.map((choice) => (
            <option value={choice.value} selected={defaults[field.name] === choice.value} class:list={optionClass}>
              {choice.label}
            </option>
          ))}
        </select>
        {field.hint && (
          <p id={`${field.id}-hint`} class:list={hintClass}>
            {field.hint}
          </p>
        )}
      </div>
    ))}
  </div>
</fieldset>

<fieldset>
  <legend class:list={legendClass}>{t.supply.wlzSection}</legend>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="supply-length" class:list={labelClass}>
        {t.supply.fields.wlzLength}
      </label>
      <input
        id="supply-length"
        name={SUPPLY_FIELDS.wlzLength}
        type="text"
        inputmode="decimal"
        autocomplete="off"
        pattern={WLZ_LENGTH_INPUT_PATTERN}
        required
        value={defaults.wlz_length_m}
        placeholder={t.supply.lengthPlaceholder}
        aria-describedby="supply-length-hint"
        class:list={inputClass}
      />
      <p id="supply-length-hint" class:list={hintClass}>
        {t.supply.lengthHint(MAX_WLZ_LENGTH_M)}
      </p>
    </div>
    {wlzFields.map((field) => (
      <div>
        <label for={field.id} class:list={labelClass}>
          {field.label}
        </label>
        <select
          id={field.id}
          name={field.name}
          required
          aria-describedby={field.hint ? `${field.id}-hint` : undefined}
          class:list={inputClass}
        >
          <option value="" disabled selected={defaults[field.name] === ""} class:list={optionClass}>
            {t.supply.choose}
          </option>
          {field.choices.map((choice) => (
            <option value={choice.value} selected={defaults[field.name] === choice.value} class:list={optionClass}>
              {choice.label}
            </option>
          ))}
        </select>
        {field.hint && (
          <p id={`${field.id}-hint`} class:list={hintClass}>
            {field.hint}
          </p>
        )}
      </div>
    ))}
  </div>
</fieldset>
