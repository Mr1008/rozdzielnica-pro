---
import { Field, FieldDescription, FieldLabel, FieldLegend, FieldSet } from "@/components/ui/field";
import { Input } from "@/components/ui/input";
import { NativeSelect } from "@/components/ui/native-select";
import { fieldControlProps, fieldHintId } from "@/lib/field-a11y";
import { t } from "@/lib/i18n";
import {
  CONDUCTOR_MATERIALS,
  EARTHING_SYSTEMS,
  MAX_WLZ_LENGTH_M,
  PHASE_COUNTS,
  PREMETER_PROTECTIONS_A,
  SUPPLY_FIELDS,
  WLZ_CROSS_SECTIONS_MM2,
  WLZ_INSTALLATIONS,
  WLZ_LENGTH_INPUT_PATTERN,
  supplyOptionValue,
  type SupplyColumn,
  type SupplyFormDefaults,
} from "@/lib/supply-params";

/**
 * The OSD and WLZ inputs of the project page's supply form. Every `<option value>` goes through
 * `supplyOptionValue`, because `parseSupplyForm` matches the option strings exactly. An unset supply
 * selects an empty, disabled placeholder, so `required` really blocks a submit with nothing picked.
 * The options are plain `<option>` children: in an `.astro` file they reach `NativeSelect` as HTML.
 */
interface Props {
  defaults: SupplyFormDefaults;
}

const { defaults } = Astro.props;

interface Choice {
  value: string;
  label: string;
}

interface SelectField {
  id: string;
  name: SupplyColumn;
  label: string;
  hint?: string;
  /** Values with a unit (amperes, mm²) render in mono figures. */
  mono?: boolean;
  choices: Choice[];
}

function choices<T extends string | number>(list: readonly T[], label: (value: T) => string): Choice[] {
  return list.map((value) => ({ value: supplyOptionValue(value), label: label(value) }));
}

const osdFields: SelectField[] = [
  {
    id: "supply-protection",
    name: SUPPLY_FIELDS.premeterProtection,
    label: t.supply.fields.premeterProtection,
    hint: t.supply.protectionHint,
    mono: true,
    choices: choices(PREMETER_PROTECTIONS_A, t.supply.protectionOption),
  },
  {
    id: "supply-earthing",
    name: SUPPLY_FIELDS.earthingSystem,
    label: t.supply.fields.earthingSystem,
    choices: choices(EARTHING_SYSTEMS, (value) => t.supply.earthingSystems[value]),
  },
  {
    id: "supply-phases",
    name: SUPPLY_FIELDS.phaseCount,
    label: t.supply.fields.phaseCount,
    choices: choices(PHASE_COUNTS, t.supply.phaseCountOption),
  },
];

const wlzFields: SelectField[] = [
  {
    id: "supply-cross-section",
    name: SUPPLY_FIELDS.wlzCrossSection,
    label: t.supply.fields.wlzCrossSection,
    hint: t.supply.crossSectionHint,
    mono: true,
    choices: choices(WLZ_CROSS_SECTIONS_MM2, t.supply.crossSectionOption),
  },
  {
    id: "supply-material",
    name: SUPPLY_FIELDS.wlzMaterial,
    label: t.supply.fields.wlzMaterial,
    choices: choices(CONDUCTOR_MATERIALS, (value) => t.supply.materials[value]),
  },
  {
    id: "supply-installation",
    name: SUPPLY_FIELDS.wlzInstallation,
    label: t.supply.fields.wlzInstallation,
    choices: choices(WLZ_INSTALLATIONS, (value) => t.supply.installations[value]),
  },
];
---

<FieldSet className="gap-4">
  <FieldLegend>{t.supply.osdSection}</FieldLegend>
  <div class="grid items-start gap-4 sm:grid-cols-3">
    {osdFields.map((field) => (
      <Field>
        <FieldLabel htmlFor={field.id}>{field.label}</FieldLabel>
        <NativeSelect
          name={field.name}
          required
          className={field.mono ? "font-mono" : undefined}
          {...fieldControlProps(field.id, { hint: field.hint })}
        >
          <option value="" disabled selected={defaults[field.name] === ""}>
            {t.supply.choose}
          </option>
          {field.choices.map((choice) => (
            <option value={choice.value} selected={defaults[field.name] === choice.value}>
              {choice.label}
            </option>
          ))}
        </NativeSelect>
        {field.hint && <FieldDescription id={fieldHintId(field.id)}>{field.hint}</FieldDescription>}
      </Field>
    ))}
  </div>
</FieldSet>

<FieldSet className="gap-4">
  <FieldLegend>{t.supply.wlzSection}</FieldLegend>
  <div class="grid items-start gap-4 sm:grid-cols-2">
    <Field>
      <FieldLabel htmlFor="supply-length">{t.supply.fields.wlzLength}</FieldLabel>
      <Input
        name={SUPPLY_FIELDS.wlzLength}
        type="text"
        inputMode="decimal"
        autoComplete="off"
        pattern={WLZ_LENGTH_INPUT_PATTERN}
        required
        defaultValue={defaults.wlz_length_m}
        placeholder={t.supply.lengthPlaceholder}
        className="font-mono"
        {...fieldControlProps("supply-length", { hint: t.supply.lengthHint(MAX_WLZ_LENGTH_M) })}
      />
      <FieldDescription id={fieldHintId("supply-length")}>{t.supply.lengthHint(MAX_WLZ_LENGTH_M)}</FieldDescription>
    </Field>
    {wlzFields.map((field) => (
      <Field>
        <FieldLabel htmlFor={field.id}>{field.label}</FieldLabel>
        <NativeSelect
          name={field.name}
          required
          className={field.mono ? "font-mono" : undefined}
          {...fieldControlProps(field.id, { hint: field.hint })}
        >
          <option value="" disabled selected={defaults[field.name] === ""}>
            {t.supply.choose}
          </option>
          {field.choices.map((choice) => (
            <option value={choice.value} selected={defaults[field.name] === choice.value}>
              {choice.label}
            </option>
          ))}
        </NativeSelect>
        {field.hint && <FieldDescription id={fieldHintId(field.id)}>{field.hint}</FieldDescription>}
      </Field>
    ))}
  </div>
</FieldSet>
