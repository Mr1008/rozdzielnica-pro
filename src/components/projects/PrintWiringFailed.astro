---
import { Alert, AlertDescription } from "@/components/ui/alert";
import { t } from "@/lib/i18n";
import { CircleAlertIcon } from "lucide-react";

/**
 * Explains, on the print page, why "Drukuj" stays disabled when the browser could not draw the wires.
 * Hidden until the page script sees `wiring-failed`; `visible` shows it outright (kitchen sink).
 */
interface Props {
  visible?: boolean;
}

const { visible = false } = Astro.props;
---

<div data-wiring-failed-explanation hidden={!visible} class="print:hidden">
  <Alert variant="destructive" role="status">
    <CircleAlertIcon aria-hidden="true" />
    <AlertDescription>{t.quotePrint.toolbar.wiringFailed}</AlertDescription>
  </Alert>
</div>
