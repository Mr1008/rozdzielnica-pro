---
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { PRICING_PROFILE_PATH } from "@/lib/pricing-profile";
import { projectPath } from "@/lib/project";
import { printBlockLinkLabel, printBlockMessage, type PrintBlockReason } from "@/lib/quote-print";
import { t } from "@/lib/i18n";
import { CircleAlertIcon } from "lucide-react";

/** Why the quote cannot be printed yet, each reason with the link that fixes it. No document, no print button. */
interface Props {
  reasons: readonly PrintBlockReason[];
  projectId: string;
}

const { reasons, projectId } = Astro.props;
const hrefs: Record<PrintBlockReason, string> = {
  no_profile: PRICING_PROFILE_PATH,
  match_not_current: `${projectPath(projectId)}#circuits`,
  layout_not_placed: `${projectPath(projectId)}#layout`,
};
---

<Alert variant="destructive" role="status">
  <CircleAlertIcon aria-hidden="true" />
  <AlertTitle>{t.quotePrint.blockedTitle}</AlertTitle>
  <AlertDescription className="block">
    <ul class="flex flex-col gap-2">
      {reasons.map((reason) => (
        <li>
          {printBlockMessage(reason)}{" "}
          <a href={hrefs[reason]} class="font-semibold underline underline-offset-4">
            {printBlockLinkLabel(reason)}
          </a>
        </li>
      ))}
    </ul>
  </AlertDescription>
</Alert>
