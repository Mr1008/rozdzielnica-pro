---
import CabinetCatalogList from "@/components/cabinets/CabinetCatalogList.astro";
import type { CabinetMounting } from "@/lib/cabinet-form";
import type { CabinetGeometry } from "@/lib/cabinet-geometry";

/**
 * The radio list of active catalog cabinets, shared by the new-project form and the project page's
 * cabinet change: the shared catalog list in picker mode, grouped by mounting and filterable. Only
 * the checked cabinet's group starts open. The checked card takes the accent; focus shows on the
 * radio itself through the global `:focus-visible` outline.
 */
interface CabinetOption {
  id: string;
  name: string;
  manufacturer: string;
  model: string;
  mounting: CabinetMounting | null;
  geometry: CabinetGeometry | null;
}

interface Props {
  cabinets: readonly CabinetOption[];
  /** The option to preselect, e.g. the project's current cabinet. */
  selectedId?: string | null;
  /** Keeps the input ids unique when a page renders more than one picker. */
  idPrefix: string;
}

const { cabinets, selectedId = null, idPrefix } = Astro.props;
---

<CabinetCatalogList mode="picker" cabinets={cabinets} selectedId={selectedId} idPrefix={idPrefix} />
