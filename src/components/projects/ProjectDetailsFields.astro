---
import { Field, FieldDescription, FieldLabel } from "@/components/ui/field";
import { Input } from "@/components/ui/input";
import { fieldControlProps, fieldHintId } from "@/lib/field-a11y";
import { t } from "@/lib/i18n";
import {
  MAX_CLIENT_NAME_LENGTH,
  MAX_PROJECT_NAME_LENGTH,
  MAX_SITE_ADDRESS_LENGTH,
  PROJECT_FIELDS,
  type ProjectDetails,
} from "@/lib/project";

/**
 * The name, client and site-address inputs, shared by the new-project form and the project page's
 * details form. `required` and `maxlength` mirror `parseProjectDetailsForm`, which the endpoint runs
 * again. `maxlength` counts UTF-16 units, so it can only be stricter than the parser's code points
 * (an emoji counts twice), never looser. The caller lays the three fields out.
 */
interface Props {
  /** A stored project to pre-fill from; the create form starts empty. */
  initial?: ProjectDetails | null;
}

const { initial = null } = Astro.props;
const optionalHint = t.projects.fields.optionalHint;
---

<Field>
  <FieldLabel htmlFor="project-name">{t.projects.fields.name}</FieldLabel>
  <Input
    name={PROJECT_FIELDS.name}
    type="text"
    required
    maxLength={MAX_PROJECT_NAME_LENGTH}
    autoComplete="off"
    defaultValue={initial?.name ?? ""}
    placeholder={t.projects.fields.namePlaceholder}
    {...fieldControlProps("project-name")}
  />
</Field>
<Field>
  <FieldLabel htmlFor="project-client">{t.projects.fields.clientName}</FieldLabel>
  <Input
    name={PROJECT_FIELDS.clientName}
    type="text"
    maxLength={MAX_CLIENT_NAME_LENGTH}
    autoComplete="off"
    defaultValue={initial?.client_name ?? ""}
    {...fieldControlProps("project-client", { hint: optionalHint })}
  />
  <FieldDescription id={fieldHintId("project-client")}>{optionalHint}</FieldDescription>
</Field>
<Field>
  <FieldLabel htmlFor="project-address">{t.projects.fields.siteAddress}</FieldLabel>
  <Input
    name={PROJECT_FIELDS.siteAddress}
    type="text"
    maxLength={MAX_SITE_ADDRESS_LENGTH}
    autoComplete="off"
    defaultValue={initial?.site_address ?? ""}
    {...fieldControlProps("project-address", { hint: optionalHint })}
  />
  <FieldDescription id={fieldHintId("project-address")}>{optionalHint}</FieldDescription>
</Field>
