---
import { CabinetDrawing } from "@/components/cabinets/CabinetDrawing";
import LayoutEditor from "@/components/projects/LayoutEditor";
import { LayoutLegend } from "@/components/projects/LayoutLegend";
import { WireLengthsTable } from "@/components/projects/WireLengthsTable";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";
import type { CabinetGeometry } from "@/lib/cabinet-geometry";
import type { DrawnCable, DrawnDevice, DrawnWire } from "@/lib/cabinet-drawing";
import { layoutFailureMessage } from "@/lib/cabinet-layout";
import { WIRE_SLACK_RATIO, type WireLengthRow } from "@/lib/cabinet-wiring";
import type { LayoutEditorData } from "@/lib/layout-editor-data";
import type { LayoutView } from "@/lib/layout-server";
import { t } from "@/lib/i18n";
import { projectLayoutApiPath, projectPlacementsApiPath } from "@/lib/project";
import { CircleAlertIcon, InfoIcon, TriangleAlertIcon } from "lucide-react";

/**
 * The "Układ w szafce" panel of the project page (FR-008): one message and one action per layout
 * state. Only a `placed` layout is drawn — a stored layout that fails validation is never shown, and
 * `does_not_fit` has nothing to draw. `view` is null while the match is not `current`, and the panel
 * then points back at the match result. A placed layout carries its wires (with sag) and, under the
 * drawing, the conductor lengths per cross-section with the installation slack included.
 *
 * With `editor` data a placed layout is the interactive editor island (FR-009, S-06); its fallback slot
 * is the static drawing, so the layout shows before the island hydrates.
 */
interface Props {
  view: LayoutView | null;
  /** The placed devices, from `buildDrawnDevices`; used only when `view.state` is `placed`. */
  devices: readonly DrawnDevice[];
  /** The placed layout's conductors, from `buildDrawnWires`; empty draws none. */
  wires?: readonly DrawnWire[];
  /** The cables' sheathed runs from the entries, from `buildDrawnCables`; empty draws none. */
  cables?: readonly DrawnCable[];
  /** The conductor lengths, from `wireLengthsBySection`; empty hides the table. */
  lengths?: readonly WireLengthRow[];
  geometry: CabinetGeometry | null;
  projectId: string;
  /** The in-page anchor of the match result's section, the link for a match that is not current. */
  matchAnchor: string;
  /**
   * The snapshot devices, groups, placements and names the editor island needs. Given, a `placed`
   * layout is the interactive editor; omitted, it is the static drawing.
   */
  editor?: LayoutEditorData | null;
  /** The page came back from a rejection (`?error=`): the editor restores the draft stored on submit. */
  restoreDraft?: boolean;
  /** The editor wrapper's anchor id; unique per editor on a page. */
  editorId?: string;
  /** What the editor's draft key is scoped by instead of the project id (the kitchen sink has several). */
  draftScope?: string;
}

const {
  view,
  devices,
  wires = [],
  cables = [],
  lengths = [],
  geometry,
  projectId,
  matchAnchor,
  editor = null,
  restoreDraft = false,
  editorId = "layout-editor",
  draftScope,
} = Astro.props;
const s = t.layout.section;
const slackPercent = Math.round(WIRE_SLACK_RATIO * 100);
---

<div class="flex flex-col gap-6">
  {view === null && (
    <Alert variant="info" role="status">
      <InfoIcon aria-hidden="true" />
      <AlertDescription className="block">
        {s.notCurrent}{" "}
        <a href={`#${matchAnchor}`} class="font-semibold underline underline-offset-4">
          {s.notCurrentLink}
        </a>
      </AlertDescription>
    </Alert>
  )}

  {view?.state === "missing" && (
    <Alert variant="info" role="status">
      <InfoIcon aria-hidden="true" />
      <AlertTitle>{s.missingTitle}</AlertTitle>
      <AlertDescription className="flex flex-col items-start gap-3">
        <span>{s.missing}</span>
        <form method="POST" action={projectLayoutApiPath(projectId)}>
          <Button type="submit" size="sm">
            {s.propose}
          </Button>
        </form>
      </AlertDescription>
    </Alert>
  )}

  {view?.state === "outdated" && (
    <Alert variant="warning" role="status">
      <TriangleAlertIcon aria-hidden="true" />
      <AlertTitle>{s.outdatedTitle}</AlertTitle>
      <AlertDescription className="flex flex-col items-start gap-3">
        <span>{s.outdated}</span>
        <form method="POST" action={projectLayoutApiPath(projectId)}>
          <Button type="submit" size="sm">
            {s.proposeAgain}
          </Button>
        </form>
      </AlertDescription>
    </Alert>
  )}

  {view?.state === "does_not_fit" && (
    <Alert variant="destructive" role="status">
      <CircleAlertIcon aria-hidden="true" />
      <AlertTitle>{s.doesNotFitTitle}</AlertTitle>
      <AlertDescription className="block">{layoutFailureMessage(view.failure)}</AlertDescription>
    </Alert>
  )}

  {view?.state === "placed" && geometry && (
    <div class="flex flex-col gap-3">
      <h3 class="text-sm font-semibold">{s.drawingTitle}</h3>
      {editor ? (
        <div id={editorId} tabindex="-1" class="scroll-mt-6">
          <LayoutEditor
            geometry={geometry}
            devices={editor.devices}
            groups={editor.groups}
            placements={editor.placements}
            editedManually={view.editedManually}
            names={editor.names}
            wires={[...wires]}
            cables={[...cables]}
            lengths={[...lengths]}
            slackPercent={slackPercent}
            saveAction={projectPlacementsApiPath(projectId)}
            reproposeAction={projectLayoutApiPath(projectId)}
            draftKey={`layout-draft:${draftScope ?? projectId}`}
            restoreDraft={restoreDraft}
            initialDraft={editor.initialDraft}
            client:only="react"
          >
            <div slot="fallback" class="flex flex-col gap-3">
              <div class="mx-auto w-full max-w-3xl">
                <CabinetDrawing geometry={geometry} devices={devices} wires={wires} cables={cables} />
              </div>
              <LayoutLegend geometry={geometry} devices={devices} wires={wires} cables={cables} />
              {lengths.length > 0 && <WireLengthsTable lengths={lengths} slackPercent={slackPercent} />}
            </div>
          </LayoutEditor>
        </div>
      ) : (
        <>
          <div class="mx-auto w-full max-w-3xl">
            <CabinetDrawing geometry={geometry} devices={devices} wires={wires} cables={cables} />
          </div>
          <LayoutLegend geometry={geometry} devices={devices} wires={wires} cables={cables} />
          {lengths.length > 0 && <WireLengthsTable lengths={lengths} slackPercent={slackPercent} />}
        </>
      )}
    </div>
  )}

  {view !== null && <p class="text-xs text-muted-foreground">{s.wlzHint}</p>}
</div>
