---
import { CabinetDrawing } from "@/components/cabinets/CabinetDrawing";
import { landingLayoutFixture } from "@/lib/kitchen-sink-circuits";
import { cn } from "@/lib/utils";

/**
 * The landing page's product picture: the demo cabinet with a real layout proposal and its wires on a
 * drafting sheet. The devices come from the real matcher, `proposeLayout` and the wiring router
 * (`landingLayoutFixture`), so the hero shows what the product produces; also on `/dev/kitchen-sink`.
 */
interface Props {
  caption: string;
  class?: string;
}

const { caption, class: className } = Astro.props;

const { geometry, devices, wires, cables } = landingLayoutFixture();
const { widthMm, heightMm } = geometry.interior;
---

<figure
  class:list={cn(
    "relative flex flex-col items-center gap-6 overflow-hidden rounded-xl border bg-drafting-grid px-8 pt-8 pb-6 text-foreground shadow-2xl",
    className,
  )}
>
  <div class="relative w-full max-w-sm" style={{ aspectRatio: `${String(widthMm)} / ${String(heightMm)}` }}>
    <CabinetDrawing
      geometry={geometry}
      devices={devices}
      wires={wires}
      cables={cables}
      className="absolute inset-0 h-full w-full"
    />
  </div>
  <figcaption class="relative z-10 max-w-sm rounded bg-card px-2 py-1 text-center font-mono text-xs text-muted-foreground">
    {caption}
  </figcaption>
</figure>
