---
import Logo from "@/components/brand/Logo.astro";
import { buttonVariants } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { t } from "@/lib/i18n";

/**
 * The body of the 500 and 503 pages, on tokens only. `embedded` renders just the panel without the
 * page layout, so `/dev/kitchen-sink` can show both states.
 */
interface Props {
  title: string;
  description: string;
  embedded?: boolean;
}

const { title, description, embedded = false } = Astro.props;
---

{embedded ? (
  <div class="flex flex-col items-center gap-4 rounded-lg border bg-card p-8 text-center text-card-foreground">
    <h2 class="text-xl font-semibold tracking-tight">{title}</h2>
    <p class="text-sm text-muted-foreground">{description}</p>
    <a href="/" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
      {t.errors.homeLink}
    </a>
  </div>
) : (
  <Layout title={title}>
    <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-4 py-10 text-center">
      <a href="/" class="rounded-md" aria-label={t.authShell.homeLink}>
        <Logo variant="full" size={32} />
      </a>
      <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
      <p class="max-w-md text-muted-foreground">{description}</p>
      <a href="/" class:list={buttonVariants({ size: "sm" })}>
        {t.errors.homeLink}
      </a>
    </main>
  </Layout>
)}
