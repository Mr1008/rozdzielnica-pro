---
import { t } from "@/lib/i18n";
import { ROLE_HOME } from "@/lib/route-access";

const { user, role } = Astro.locals;

// Link each role at its own home. Pointing everyone at /dashboard would give an admin a dead-end
// link: the route gate refuses it and bounces them straight back to /admin. A signed-in user with
// no recognised role gets no panel link at all, because no gated route will let them in.
const home = role === null ? null : { href: ROLE_HOME[role], label: role === "admin" ? t.nav.admin : t.nav.dashboard };
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80">
  {user ? (
    <>
      <span class="text-blue-100/70">{user.email}</span>
      <div class="flex items-center gap-3">
        {home && (
          <a href={home.href} class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {home.label}
          </a>
        )}
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            {t.nav.signOut}
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-blue-100/70">{t.nav.notSignedIn}</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          {t.nav.signIn}
        </a>
        <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          {t.nav.signUp}
        </a>
      </div>
    </>
  )}
</div>
