---
import { Alert, AlertDescription } from "@/components/ui/alert";
import { cn } from "@/lib/utils";
import { CircleAlertIcon, CircleCheckIcon, InfoIcon, TriangleAlertIcon } from "lucide-react";

/**
 * A page-level message on the `Alert` status tokens. An error is announced (`role="alert"`); every
 * other variant is a polite `status`. Links inside inherit the variant's colour and stay underlined.
 */
type Variant = "info" | "success" | "warning" | "error";

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = "info", class: className } = Astro.props;

const ALERT_VARIANT = {
  info: "info",
  success: "success",
  warning: "warning",
  error: "destructive",
} as const satisfies Record<Variant, string>;

const ICONS = {
  info: InfoIcon,
  success: CircleCheckIcon,
  warning: TriangleAlertIcon,
  error: CircleAlertIcon,
} as const satisfies Record<Variant, unknown>;

const Icon = ICONS[variant];
---

<Alert
  variant={ALERT_VARIANT[variant]}
  role={variant === "error" ? "alert" : "status"}
  className={cn(variant === "error" && "border-destructive/40 bg-destructive-muted", className)}
>
  <Icon aria-hidden="true" />
  <AlertDescription className="block [&_a]:font-semibold [&_a]:text-current [&_a]:underline">
    <slot />
  </AlertDescription>
</Alert>
