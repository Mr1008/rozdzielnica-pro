---
import { ArrowLeftIcon } from "lucide-react";

/**
 * The page's own header inside `AppLayout`: an optional back link, the `h1`, an optional muted
 * description, and an `actions` slot aligned to the right on wider screens.
 */
interface Props {
  title: string;
  backHref?: string;
  backLabel?: string;
  description?: string | null;
}

const { title, backHref, backLabel, description } = Astro.props;
const hasActions = Astro.slots.has("actions");
---

<header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="flex min-w-0 flex-col gap-1">
    {backHref && backLabel && (
      <a
        href={backHref}
        class="mb-1 inline-flex w-fit items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground hover:underline"
      >
        <ArrowLeftIcon className="size-4" aria-hidden="true" />
        {backLabel}
      </a>
    )}
    <h1 class="text-2xl font-semibold tracking-tight break-words">{title}</h1>
    {description && <p class="text-sm text-muted-foreground">{description}</p>}
  </div>
  {hasActions && (
    <div class="flex shrink-0 items-center gap-2">
      <slot name="actions" />
    </div>
  )}
</header>
