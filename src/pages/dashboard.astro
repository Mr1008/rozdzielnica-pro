---
import PageHeader from "@/components/PageHeader.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import AppLayout from "@/layouts/AppLayout.astro";
import { t } from "@/lib/i18n";
import { PRICING_PROFILE_PATH } from "@/lib/pricing-profile";
import { PROJECTS_PATH } from "@/lib/project";
import { createClient } from "@/lib/supabase";
import { ChevronRightIcon, FolderOpenIcon, ReceiptTextIcon, TriangleAlertIcon } from "lucide-react";

const { user } = Astro.locals;

/**
 * Whether the electrician still has no pricing profile — the "not configured" state S-08 blocks on.
 * Only a confirmed absence shows the notice: an unconfigured client or a failed load degrades to the
 * plain link, never to an error page.
 */
async function pricingMissing(): Promise<boolean> {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase || !user) return false;
  const { data, error } = await supabase
    .from("pricing_profiles")
    .select("user_id")
    .eq("user_id", user.id)
    .maybeSingle();
  if (error) {
    // The SQLSTATE only, never Supabase's message.
    // eslint-disable-next-line no-console
    console.error("pricing profile check failed", error.code);
    return false;
  }
  return data === null;
}

const showPricingNotice = await pricingMissing();

const destinations = [
  {
    href: PROJECTS_PATH,
    icon: FolderOpenIcon,
    title: t.projects.dashboardLink,
    description: t.projects.dashboardLinkDescription,
  },
  {
    href: PRICING_PROFILE_PATH,
    icon: ReceiptTextIcon,
    title: t.pricingProfile.dashboardLink,
    description: t.pricingProfile.dashboardLinkDescription,
  },
];
---

<AppLayout title={t.dashboard.title}>
  <PageHeader
    title={user?.email ? t.dashboard.greetingTitle(user.email) : t.dashboard.title}
    description={t.dashboard.description}
  />

  {showPricingNotice && (
    <Alert variant="warning" role="status" className="mb-6">
      <TriangleAlertIcon aria-hidden="true" />
      <AlertDescription className="block">
        {t.pricingProfile.notConfigured}{" "}
        <a href={PRICING_PROFILE_PATH} class="font-semibold underline underline-offset-4">
          {t.pricingProfile.notConfiguredLink}
        </a>
      </AlertDescription>
    </Alert>
  )}

  <nav aria-label={t.dashboard.destinationsLabel}>
    <ul class="grid gap-4 md:grid-cols-2">
      {destinations.map(({ href, icon: Icon, title, description }) => (
        <li>
          <a href={href} class="group block h-full rounded-xl">
            <Card className="h-full flex-row items-center gap-4 px-6 transition-colors group-hover:border-primary/60 group-hover:bg-accent">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon className="size-6" aria-hidden="true" />
              </span>
              <CardHeader className="flex-1 px-0">
                <CardTitle className="text-lg">{title}</CardTitle>
                <CardDescription>{description}</CardDescription>
              </CardHeader>
              <ChevronRightIcon
                className="size-5 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </Card>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</AppLayout>
