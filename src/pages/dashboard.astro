---
import Layout from "@/layouts/Layout.astro";
import { t } from "@/lib/i18n";
import { PRICING_PROFILE_PATH } from "@/lib/pricing-profile";
import { PROJECTS_PATH } from "@/lib/project";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

/**
 * Whether the electrician still has no pricing profile — the "not configured" state S-08 blocks on.
 * Only a confirmed absence shows the notice: an unconfigured client or a failed load degrades to the
 * plain link, never to an error page.
 */
async function pricingMissing(): Promise<boolean> {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase || !user) return false;
  const { data, error } = await supabase
    .from("pricing_profiles")
    .select("user_id")
    .eq("user_id", user.id)
    .maybeSingle();
  if (error) {
    // The SQLSTATE only, never Supabase's message.
    // eslint-disable-next-line no-console
    console.error("pricing profile check failed", error.code);
    return false;
  }
  return data === null;
}

const showPricingNotice = await pricingMissing();
---

<Layout title={t.dashboard.title}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {t.dashboard.title}
      </h1>
      <p class="text-blue-100/80">
        {t.dashboard.greeting} <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">{t.dashboard.restricted}</p>

      {showPricingNotice && (
        <p
          role="status"
          class="mt-6 rounded-xl border border-amber-300/40 bg-amber-300/10 p-3 text-left text-sm text-amber-100"
        >
          {t.pricingProfile.notConfigured}
        </p>
      )}

      <nav class="mt-6 flex flex-col gap-3 text-left">
        <a
          href={PROJECTS_PATH}
          class="block rounded-xl border border-white/20 bg-white/10 p-4 transition-colors hover:bg-white/20"
        >
          <span class="font-semibold text-white">{t.projects.dashboardLink}</span>
          <span class="mt-1 block text-sm text-blue-100/70">{t.projects.dashboardLinkDescription}</span>
        </a>
        <a
          href={PRICING_PROFILE_PATH}
          class="block rounded-xl border border-white/20 bg-white/10 p-4 transition-colors hover:bg-white/20"
        >
          <span class="font-semibold text-white">{t.pricingProfile.dashboardLink}</span>
          <span class="mt-1 block text-sm text-blue-100/70">{t.pricingProfile.dashboardLinkDescription}</span>
        </a>
      </nav>

      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          {t.nav.signOut}
        </button>
      </form>
    </div>
  </div>
</Layout>
