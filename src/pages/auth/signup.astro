---
import SignUpForm from "@/components/auth/SignUpForm";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { authErrorMessage } from "@/lib/auth-errors";
import { t } from "@/lib/i18n";

const error = authErrorMessage(Astro.url.searchParams.get("error"));
---

<AuthLayout title={t.auth.signUpTitle}>
  <SignUpForm serverError={error} client:load />
  <p slot="footer" class="text-sm text-muted-foreground">
    {t.auth.hasAccount}{" "}
    <a href="/auth/signin" class="font-medium text-primary underline-offset-4 hover:underline">
      {t.nav.signIn}
    </a>
  </p>
</AuthLayout>
