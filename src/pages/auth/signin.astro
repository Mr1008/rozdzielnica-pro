---
import SignInForm from "@/components/auth/SignInForm";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { authErrorMessage } from "@/lib/auth-errors";
import { t } from "@/lib/i18n";

const error = authErrorMessage(Astro.url.searchParams.get("error"));
---

<AuthLayout title={t.auth.signInTitle}>
  <SignInForm serverError={error} client:load />
  <p slot="footer" class="text-sm text-muted-foreground">
    {t.auth.noAccount}{" "}
    <a href="/auth/signup" class="font-medium text-primary underline-offset-4 hover:underline">
      {t.nav.signUp}
    </a>
  </p>
</AuthLayout>
