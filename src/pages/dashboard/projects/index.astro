---
import Banner from "@/components/Banner.astro";
import PageHeader from "@/components/PageHeader.astro";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import AppLayout from "@/layouts/AppLayout.astro";
import { formatDate, t } from "@/lib/i18n";
import { NEW_PROJECT_PATH, projectPath } from "@/lib/project";
import { projectErrorMessage } from "@/lib/project-errors";
import { ROLE_HOME } from "@/lib/route-access";
import { createClient } from "@/lib/supabase";
import { supplyFromRow } from "@/lib/supply-params";
import { PlusIcon } from "lucide-react";

// No role check here on purpose: `/dashboard/*` is gated to electricians in
// `src/lib/route-access.ts`, and RLS returns only the caller's own projects.
const actionError = projectErrorMessage(Astro.url.searchParams.get("error"));
const deleted = Astro.url.searchParams.get("deleted") === "1" && actionError === null;

async function loadProjects() {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  // `createClient()` is null when the Supabase env vars are unset.
  if (!supabase) return { rows: [], loadError: t.projectErrors.notConfigured };

  const { data, error } = await supabase
    .from("projects")
    .select(
      "id, name, client_name, cabinet_name, updated_at, premeter_protection_a, earthing_system, phase_count, wlz_length_m, wlz_cross_section_mm2, wlz_material, wlz_installation",
    )
    .order("updated_at", { ascending: false });
  if (error) {
    // The SQLSTATE only, never Supabase's message — `wrangler tail` is the only trace a failure leaves.
    // eslint-disable-next-line no-console
    console.error("projects list load failed", error.code);
    Astro.response.status = 500;
    return { rows: [], loadError: t.projects.list.loadFailed };
  }
  return { rows: data, loadError: null };
}

const { rows, loadError } = await loadProjects();

const projects = rows.map((row) => ({ ...row, supplyMissing: supplyFromRow(row) === null }));
---

<AppLayout title={t.projects.list.title}>
  {actionError && (
    <Banner slot="banners" variant="error">
      {actionError}
    </Banner>
  )}
  {loadError && (
    <Banner slot="banners" variant="error">
      {loadError}
    </Banner>
  )}
  {deleted && (
    <Banner slot="banners" variant="success">
      {t.projects.list.deleted}
    </Banner>
  )}

  <PageHeader
    title={t.projects.list.title}
    backHref={ROLE_HOME.elektryk}
    backLabel={t.projects.list.backToDashboard}
    description={t.projects.list.description}
  >
    <a slot="actions" href={NEW_PROJECT_PATH} class:list={buttonVariants()}>
      <PlusIcon aria-hidden="true" />
      {t.projects.list.newProject}
    </a>
  </PageHeader>

  {!loadError && projects.length === 0 && (
    <Card className="items-center border-dashed text-center shadow-none">
      <CardContent className="flex flex-col items-center gap-4">
        <p class="max-w-md text-muted-foreground">{t.projects.list.empty}</p>
        <a href={NEW_PROJECT_PATH} class:list={buttonVariants()}>
          <PlusIcon aria-hidden="true" />
          {t.projects.list.newProject}
        </a>
      </CardContent>
    </Card>
  )}

  {projects.length > 0 && (
    <Card className="gap-0 overflow-x-auto py-0">
      <table class="w-full border-collapse text-sm">
        <caption class="px-6 pt-4 pb-2 text-left text-muted-foreground">
          {t.projects.list.count(projects.length)}
        </caption>
        <thead>
          <tr class="border-b text-left text-muted-foreground">
            <th scope="col" class="px-6 py-3 font-medium">
              {t.projects.list.columns.name}
            </th>
            <th scope="col" class="px-6 py-3 font-medium">
              {t.projects.list.columns.client}
            </th>
            <th scope="col" class="px-6 py-3 font-medium">
              {t.projects.list.columns.cabinet}
            </th>
            <th scope="col" class="px-6 py-3 text-right font-medium">
              {t.projects.list.columns.updatedAt}
            </th>
          </tr>
        </thead>
        <tbody>
          {projects.map((project) => (
            <tr class="border-b last:border-b-0 hover:bg-muted">
              <th scope="row" class="px-6 py-3 text-left font-normal">
                <span class="flex flex-wrap items-center gap-2">
                  <a
                    href={projectPath(project.id)}
                    class="font-semibold text-foreground underline-offset-4 hover:text-primary hover:underline"
                  >
                    {project.name}
                  </a>
                  {project.supplyMissing && <Badge variant="warning">{t.projects.list.supplyMissingBadge}</Badge>}
                </span>
              </th>
              <td class:list={["px-6 py-3", project.client_name === null && "text-muted-foreground"]}>
                {project.client_name ?? t.projects.list.noClient}
              </td>
              <td class="px-6 py-3">{project.cabinet_name}</td>
              <td class="px-6 py-3 text-right font-mono whitespace-nowrap text-muted-foreground">
                {formatDate(project.updated_at, Astro.locals.timeZone)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </Card>
  )}
</AppLayout>
