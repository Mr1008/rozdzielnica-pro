---
import Banner from "@/components/Banner.astro";
import PageHeader from "@/components/PageHeader.astro";
import { CabinetDrawing } from "@/components/cabinets/CabinetDrawing";
import CabinetPicker from "@/components/projects/CabinetPicker.astro";
import CircuitEditor from "@/components/circuits/CircuitEditor";
import LayoutSection from "@/components/projects/LayoutSection.astro";
import MatchResult from "@/components/projects/MatchResult.astro";
import QuoteSection from "@/components/projects/QuoteSection.astro";
import ProjectDetailsFields from "@/components/projects/ProjectDetailsFields.astro";
import SupplyFields from "@/components/projects/SupplyFields.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import AppLayout from "@/layouts/AppLayout.astro";
import { buildDrawnCables, buildDrawnDevices, buildDrawnWires } from "@/lib/cabinet-drawing";
import { wireLengthsBySection } from "@/lib/cabinet-wiring";
import { ENTRY_SIDES, parseCabinetGeometry } from "@/lib/cabinet-geometry";
import { isUuid, sortForCatalogList } from "@/lib/catalog";
import { payloadToDraft } from "@/lib/circuit-draft";
import { computeMatchView, type MatchView } from "@/lib/device-matching-server";
import { formatMoney, t } from "@/lib/i18n";
import { computeLayoutView, computeWiring, loadLayoutContext, type LayoutView } from "@/lib/layout-server";
import {
  PROJECTS_PATH,
  PROJECT_FIELDS,
  projectApiPath,
  projectCabinetApiPath,
  projectCircuitsApiPath,
  projectDeleteApiPath,
  projectSupplyApiPath,
} from "@/lib/project";
import { projectErrorMessage } from "@/lib/project-errors";
import { computeQuoteView, type QuoteView } from "@/lib/quote";
import { createClient } from "@/lib/supabase";
import { supplyFormDefaults, supplyFromRow } from "@/lib/supply-params";
import { supplyWarningMessage, supplyWarnings } from "@/lib/supply-warnings";
import { CircleAlertIcon, CircleCheckIcon, TriangleAlertIcon } from "lucide-react";

// No role check here on purpose: `/dashboard/*` is gated to electricians in
// `src/lib/route-access.ts`, and RLS returns only the caller's own project — another electrician's
// id reads exactly like one that does not exist.
const { id } = Astro.params;
const error = projectErrorMessage(Astro.url.searchParams.get("error"));
const created = Astro.url.searchParams.get("created") === "1" && error === null;
const savedParam = error === null ? Astro.url.searchParams.get("saved") : null;
const saved =
  savedParam === "details"
    ? t.projects.page.savedDetails
    : savedParam === "cabinet"
      ? t.projects.page.savedCabinet
      : savedParam === "supply"
        ? t.supply.saved
        : savedParam === "circuits"
          ? t.projects.page.savedCircuits
          : savedParam === "rematch"
            ? t.projects.page.savedRematch
            : savedParam === "layout"
              ? t.projects.page.savedLayout
              : savedParam === "quote"
                ? t.projects.page.savedQuote
                : null;

const supabase = createClient(Astro.request.headers, Astro.cookies);

async function loadProject() {
  // Checked before querying: a non-UUID would reach PostgREST as `22P02` and read as a failure,
  // when it is simply a project that does not exist.
  if (!isUuid(id)) return { project: null, loadError: null };
  if (!supabase) return { project: null, loadError: t.projectErrors.notConfigured };

  const { data, error: queryError } = await supabase
    .from("projects")
    .select(
      "id, name, client_name, site_address, cabinet_id, cabinet_name, cabinet_manufacturer, cabinet_model, cabinet_geometry, premeter_protection_a, earthing_system, phase_count, wlz_length_m, wlz_cross_section_mm2, wlz_material, wlz_installation, cabinet_price_grosze, labour_minutes_override, labour_override_base_minutes",
    )
    .eq("id", id)
    .maybeSingle();
  if (queryError) {
    // The SQLSTATE only, never Supabase's message — `wrangler tail` is the only trace a failure leaves.
    // eslint-disable-next-line no-console
    console.error("project load failed", queryError.code);
    Astro.response.status = 500;
    return { project: null, loadError: t.projects.page.loadFailed };
  }
  return { project: data, loadError: null };
}

/** The active catalog cabinets for the change form. A failure here leaves the rest of the page up. */
async function loadCabinets() {
  if (!supabase) return { cabinets: [], cabinetsError: t.projectErrors.notConfigured };
  // RLS already hides archived cabinets from an electrician; the filter repeats it, so the picker
  // never offers one the snapshot trigger would refuse.
  const { data, error: queryError } = await supabase
    .from("cabinets")
    .select("id, name, manufacturer, model, geometry, archived_at")
    .is("archived_at", null);
  if (queryError) {
    // eslint-disable-next-line no-console
    console.error("project cabinet picker load failed", queryError.code);
    return { cabinets: [], cabinetsError: t.projects.cabinet.loadFailed };
  }
  const cabinets = sortForCatalogList(data).map(({ id: cabinetId, name, manufacturer, model, geometry }) => {
    const parsed = parseCabinetGeometry(geometry);
    return { id: cabinetId, name, manufacturer, model, geometry: parsed.ok ? parsed.geometry : null };
  });
  return { cabinets, cabinetsError: null };
}

// The pricing profile needs only the signed-in user, so it loads alongside the project rather than
// after the match. `loadPricingProfile` is a hoisted declaration below.
const [{ project, loadError }, profileLoad] = await Promise.all([loadProject(), loadPricingProfile()]);
if (!project && !loadError) Astro.response.status = 404;

const { cabinets, cabinetsError } = project ? await loadCabinets() : { cabinets: [], cabinetsError: null };

// The snapshot passed `parseCabinetGeometry` on its way into the catalog; parsing again only guards
// the drawing. A snapshot that does not parse omits the drawing rather than failing the page.
const snapshotGeometry = project ? parseCabinetGeometry(project.cabinet_geometry) : null;
const currentStillActive = project !== null && cabinets.some((cabinet) => cabinet.id === project.cabinet_id);

// Null is "not configured": the form starts empty and no warnings are computed from invented values.
const supply = project ? supplyFromRow(project) : null;
const supplyDefaults = supplyFormDefaults(project);
const warningMessages = supply ? supplyWarnings(supply).map(supplyWarningMessage) : [];

// Circuits, groups, the active catalog and the stored device snapshot. A failure here shows an alert in
// the section and leaves the rest of the page up.
const matchLoad = project && supabase ? await loadLayoutContext(supabase, project.id, project) : null;
const matchContext = matchLoad?.ok ? matchLoad.context : null;
const matchView = matchContext ? computeMatchView(matchContext) : null;
// The layout state is read only through `computeLayoutView`, never from the raw placement rows.
const layoutView =
  matchLoad?.ok && matchView ? computeLayoutView(matchView, matchLoad.context, matchLoad.placements) : null;
const placedDevices =
  layoutView?.state === "placed" && matchContext?.geometry
    ? buildDrawnDevices(matchView?.snapshot ?? [], layoutView.placements, matchContext.geometry, matchContext.groups)
    : [];
// Wires are display-only and drawn only over a `placed` layout; the aside thumbnail stays without them.
const conductors = matchContext && matchView ? computeWiring(layoutView, matchView, matchContext) : [];
const placedWires = buildDrawnWires(conductors, {
  circuits: new Map((matchContext?.circuits ?? []).map((circuit) => [circuit.id, circuit.name])),
  devices: placedDevices,
});
const placedCables = buildDrawnCables(conductors);
const wireLengths = wireLengthsBySection(conductors);

/**
 * The electrician's pricing profile, for the quote. No row is "not configured" (null) and blocks the
 * quote; a load error is reported in the section and never replaced by defaults.
 */
async function loadPricingProfile() {
  const { user } = Astro.locals;
  if (!supabase || !user) return { profile: null, profileError: t.projectErrors.notConfigured };
  const { data, error: queryError } = await supabase
    .from("pricing_profiles")
    .select("hourly_rate_grosze, mount_minutes_per_device, project_overhead_minutes")
    .eq("user_id", user.id)
    .maybeSingle();
  if (queryError) {
    // The SQLSTATE only, never Supabase's message.
    // eslint-disable-next-line no-console
    console.error("project quote profile load failed", queryError.code);
    return { profile: null, profileError: t.quote.loadFailed };
  }
  return { profile: data, profileError: null };
}

const { profile, profileError } = project ? profileLoad : { profile: null, profileError: null };
const quoteView =
  project && matchView && !profileError
    ? computeQuoteView({
        matchView,
        cabinet: { name: project.cabinet_name, priceGrosze: project.cabinet_price_grosze },
        profile,
        override:
          project.labour_minutes_override !== null && project.labour_override_base_minutes !== null
            ? { minutes: project.labour_minutes_override, baseMinutes: project.labour_override_base_minutes }
            : null,
      })
    : null;

/** The aside badge per quote state: the total for a ready quote, otherwise why there is none. */
function quoteBadge(view: QuoteView | null): {
  variant: "success" | "warning" | "destructive" | "secondary";
  text: string;
} {
  if (view === null) return { variant: "secondary", text: t.quote.badges.unavailable };
  switch (view.state) {
    case "ready":
      return { variant: "success", text: formatMoney(view.totalGrosze / 100) };
    case "no_profile":
      return { variant: "warning", text: t.quote.badges.notConfigured };
    case "not_current":
      return { variant: "secondary", text: t.quote.badges.notCurrent };
  }
}
const quoteStatus = quoteBadge(quoteView);

/** The aside badge per match state: only a stored snapshot counts as "matched". */
function matchingBadge(view: MatchView | null): {
  variant: "success" | "warning" | "destructive" | "secondary";
  text: string;
} {
  if (view === null) return { variant: "secondary", text: t.projects.page.matchingUnavailable };
  switch (view.state) {
    case "current":
      return { variant: "success", text: t.projects.page.matchingCurrent(view.snapshot.length) };
    case "stale":
    case "cleared":
      return { variant: "warning", text: t.projects.page.matchingOutdated };
    case "gaps":
      return { variant: "destructive", text: t.projects.page.matchingGaps };
    case "blocked":
      return view.fresh.status === "blocked" && view.fresh.reasons.some((reason) => reason.code === "no_circuits")
        ? { variant: "secondary", text: t.projects.page.matchingNoCircuits }
        : { variant: "destructive", text: t.projects.page.matchingBlocked };
  }
}
const matching = matchingBadge(matchView);

/** The aside badge per layout state; no state at all means the match is not current (or did not load). */
function layoutBadge(view: LayoutView | null): {
  variant: "success" | "warning" | "destructive" | "secondary";
  text: string;
} {
  if (matchView === null) return { variant: "secondary", text: t.projects.page.layoutUnavailable };
  if (view === null) return { variant: "secondary", text: t.projects.page.layoutNotCurrent };
  switch (view.state) {
    case "placed":
      return { variant: "success", text: t.projects.page.layoutPlaced };
    case "missing":
      return { variant: "secondary", text: t.projects.page.layoutMissing };
    case "does_not_fit":
      return { variant: "destructive", text: t.projects.page.layoutDoesNotFit };
    case "outdated":
      return { variant: "warning", text: t.projects.page.layoutOutdated };
  }
}
const layoutStatus = layoutBadge(layoutView);

// The circuit editor's anchor, the fix link for circuit blockers.
const circuitsEditorId = "circuit-editor";
// The match result's own anchor, the link for a layout that waits on a current match.
const circuitsSectionId = "circuits";

// The editor starts from the saved rows; the entry sides it lists first are the snapshot's own.
const circuitDraft = payloadToDraft(
  matchContext ? { groups: matchContext.groups, circuits: matchContext.circuits } : null,
);
const cabinetEntrySides = snapshotGeometry?.ok
  ? ENTRY_SIDES.filter((side) => snapshotGeometry.geometry.entries.some((entry) => entry.side === side))
  : [];
const restoreCircuitDraft = Astro.url.searchParams.has("error");

const title = project ? project.name : t.projects.page.notFoundTitle;
const headerParts = project
  ? [project.client_name, project.site_address].flatMap((part) => (part?.trim() ? [part] : []))
  : [];
const description = headerParts.length > 0 ? t.projects.page.headerDescription(headerParts) : null;

// The in-page sections, in page order. Each id sits on the section's heading, which takes
// `tabindex="-1"` so following the anchor moves focus there, not only the scroll position.
const sections = [
  { id: "details", label: t.projects.page.detailsSection },
  { id: "cabinet", label: t.projects.cabinet.section },
  { id: "supply", label: t.supply.section },
  { id: "circuits", label: t.circuitSection.section },
  { id: "layout", label: t.layout.section.title },
  { id: "quote", label: t.quote.section },
  { id: "delete", label: t.projects.delete.section },
] as const;

// `scroll-mt-6`: an anchor jump lands the heading below the viewport edge, so its focus outline is not clipped.
const headingClass = "scroll-mt-6 text-lg leading-none font-semibold";
---

<AppLayout title={title} width="wide">
  {loadError && (
    <Banner slot="banners" variant="error">
      {loadError}
    </Banner>
  )}
  {error && (
    <Banner slot="banners" variant="error">
      {error}
    </Banner>
  )}
  {created && (
    <Banner slot="banners" variant="success">
      {t.projects.page.created}
    </Banner>
  )}
  {saved && (
    <Banner slot="banners" variant="success">
      {saved}
    </Banner>
  )}

  <PageHeader title={title} backHref={PROJECTS_PATH} backLabel={t.projects.page.backToList} description={description} />

  {!project && !loadError && (
    <Card className="items-center border-dashed text-center shadow-none">
      <CardContent>
        <p class="text-muted-foreground">{t.projects.page.notFound}</p>
      </CardContent>
    </Card>
  )}

  {project && (
    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="flex min-w-0 flex-col gap-6">
        <section class="scroll-mt-6" aria-labelledby="details">
          <Card>
            <CardHeader>
              <h2 id="details" tabindex="-1" class:list={headingClass}>
                {t.projects.page.detailsSection}
              </h2>
            </CardHeader>
            <CardContent>
              <form method="POST" action={projectApiPath(project.id)} class="flex flex-col gap-5">
                <div class="grid items-start gap-4 md:grid-cols-3">
                  <ProjectDetailsFields initial={project} />
                </div>
                <div>
                  <Button type="submit">{t.projects.page.saveDetails}</Button>
                </div>
              </form>
            </CardContent>
          </Card>
        </section>

        <section class="scroll-mt-6" aria-labelledby="cabinet">
          <Card>
            <CardHeader>
              <h2 id="cabinet" tabindex="-1" class:list={headingClass}>
                {t.projects.cabinet.section}
              </h2>
              <CardDescription>{t.projects.cabinet.snapshotHint}</CardDescription>
            </CardHeader>
            <CardContent className="flex flex-col gap-6">
              <div class="flex flex-col gap-3">
                <p class="font-semibold">{project.cabinet_name}</p>
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                  <dt class="text-muted-foreground">{t.cabinets.fields.manufacturer}</dt>
                  <dd>{project.cabinet_manufacturer}</dd>
                  <dt class="text-muted-foreground">{t.cabinets.fields.model}</dt>
                  <dd class="font-mono">{project.cabinet_model}</dd>
                </dl>
                {!cabinetsError && !currentStillActive && (
                  <Alert variant="warning" role={undefined}>
                    <TriangleAlertIcon aria-hidden="true" />
                    <AlertDescription>{t.projects.cabinet.currentArchived}</AlertDescription>
                  </Alert>
                )}
              </div>

              <Separator />

              <form method="POST" action={projectCabinetApiPath(project.id)} class="flex flex-col gap-4">
                <fieldset class="flex flex-col gap-3">
                  <legend class="mb-1 font-medium">{t.projects.cabinet.changeTitle}</legend>
                  <p class="text-sm text-muted-foreground">{t.projects.cabinet.changeHint}</p>
                  {cabinetsError && (
                    <Alert variant="destructive" role={undefined}>
                      <CircleAlertIcon aria-hidden="true" />
                      <AlertDescription>{cabinetsError}</AlertDescription>
                    </Alert>
                  )}
                  {!cabinetsError && cabinets.length === 0 && (
                    <Alert variant="warning" role={undefined}>
                      <TriangleAlertIcon aria-hidden="true" />
                      <AlertDescription>{t.projects.cabinet.noCabinets}</AlertDescription>
                    </Alert>
                  )}
                  {cabinets.length > 0 && (
                    <CabinetPicker
                      cabinets={cabinets}
                      selectedId={currentStillActive ? project.cabinet_id : null}
                      idPrefix="change-cabinet"
                    />
                  )}
                </fieldset>
                {cabinets.length > 0 && (
                  <div>
                    <Button type="submit" variant="outline">
                      {t.projects.cabinet.change}
                    </Button>
                  </div>
                )}
              </form>
            </CardContent>
          </Card>
        </section>

        <section class="scroll-mt-6" aria-labelledby="supply">
          <Card>
            <CardHeader>
              <h2 id="supply" tabindex="-1" class:list={headingClass}>
                {t.supply.section}
              </h2>
              <CardDescription>{t.supply.description}</CardDescription>
            </CardHeader>
            <CardContent className="flex flex-col gap-6">
              {supply ? (
                <div role="status" class="flex flex-col gap-3">
                  <h3 class="text-sm font-semibold">{t.supply.warningsTitle}</h3>
                  {warningMessages.length > 0 ? (
                    <ul class="flex flex-col gap-2">
                      {warningMessages.map((message) => (
                        <li>
                          <Alert variant="warning" role={undefined}>
                            <TriangleAlertIcon aria-hidden="true" />
                            <AlertDescription className="block">
                              <strong>{t.common.warningPrefix}</strong> {message}
                            </AlertDescription>
                          </Alert>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <Alert variant="success" role={undefined}>
                      <CircleCheckIcon aria-hidden="true" />
                      <AlertDescription>{t.supplyWarnings.none}</AlertDescription>
                    </Alert>
                  )}
                  <p class="text-xs text-muted-foreground">{t.supplyWarnings.note}</p>
                </div>
              ) : (
                <Alert variant="warning" role="status">
                  <TriangleAlertIcon aria-hidden="true" />
                  <AlertDescription>{t.supply.notConfigured}</AlertDescription>
                </Alert>
              )}

              <form method="POST" action={projectSupplyApiPath(project.id)} class="flex flex-col gap-6">
                <SupplyFields defaults={supplyDefaults} />
                <div>
                  <Button type="submit">{t.supply.save}</Button>
                </div>
              </form>
            </CardContent>
          </Card>
        </section>

        <section class="scroll-mt-6" aria-labelledby="circuits">
          <Card>
            <CardHeader>
              <h2 id="circuits" tabindex="-1" class:list={headingClass}>
                {t.circuitSection.section}
              </h2>
              <CardDescription>{t.circuitSection.description}</CardDescription>
            </CardHeader>
            <CardContent className="flex flex-col gap-6">
              {matchContext && matchView ? (
                <>
                  {/* `client:only`: the editor restores a rejected draft from sessionStorage on its first render.
                      The wrapper carries the anchor, so the fix links work before the island hydrates. */}
                  <div id={circuitsEditorId} tabindex="-1" class="scroll-mt-6">
                    <CircuitEditor
                      action={projectCircuitsApiPath(project.id)}
                      initial={circuitDraft}
                      cabinetEntrySides={cabinetEntrySides}
                      draftKey={`circuit-draft:${project.id}`}
                      restoreDraft={restoreCircuitDraft}
                      client:only="react"
                    >
                      <p slot="fallback" class="text-sm text-muted-foreground">
                        {t.common.loading}
                      </p>
                    </CircuitEditor>
                  </div>

                  <Separator />

                  <MatchResult
                    view={matchView}
                    context={matchContext}
                    projectId={project.id}
                    circuitsAnchor={circuitsEditorId}
                  />
                </>
              ) : (
                <Alert variant="destructive" role={undefined}>
                  <CircleAlertIcon aria-hidden="true" />
                  <AlertDescription>
                    {supabase ? t.circuitSection.loadFailed : t.projectErrors.notConfigured}
                  </AlertDescription>
                </Alert>
              )}
            </CardContent>
          </Card>
        </section>

        <section class="scroll-mt-6" aria-labelledby="layout">
          <Card>
            <CardHeader>
              <h2 id="layout" tabindex="-1" class:list={headingClass}>
                {t.layout.section.title}
              </h2>
              <CardDescription>{t.layout.section.description}</CardDescription>
            </CardHeader>
            <CardContent>
              {matchContext && matchView ? (
                <LayoutSection
                  view={layoutView}
                  devices={placedDevices}
                  wires={placedWires}
                  cables={placedCables}
                  lengths={wireLengths}
                  geometry={matchContext.geometry}
                  projectId={project.id}
                  matchAnchor={circuitsSectionId}
                />
              ) : (
                <Alert variant="destructive" role={undefined}>
                  <CircleAlertIcon aria-hidden="true" />
                  <AlertDescription>
                    {supabase ? t.circuitSection.loadFailed : t.projectErrors.notConfigured}
                  </AlertDescription>
                </Alert>
              )}
            </CardContent>
          </Card>
        </section>

        <section class="scroll-mt-6" aria-labelledby="quote">
          <Card>
            <CardHeader>
              <h2 id="quote" tabindex="-1" class:list={headingClass}>
                {t.quote.section}
              </h2>
              <CardDescription>{t.quote.description}</CardDescription>
            </CardHeader>
            <CardContent>
              {quoteView ? (
                <QuoteSection view={quoteView} projectId={project.id} matchAnchor={circuitsSectionId} />
              ) : (
                <Alert variant="destructive" role={undefined}>
                  <CircleAlertIcon aria-hidden="true" />
                  <AlertDescription>
                    {profileError ?? (supabase ? t.circuitSection.loadFailed : t.projectErrors.notConfigured)}
                  </AlertDescription>
                </Alert>
              )}
            </CardContent>
          </Card>
        </section>

        <section class="scroll-mt-6" aria-labelledby="delete">
          <Card className="border-destructive/40">
            <CardHeader>
              <h2 id="delete" tabindex="-1" class:list={[headingClass, "text-destructive"]}>
                {t.projects.delete.section}
              </h2>
              <CardDescription>{t.projects.delete.hint}</CardDescription>
            </CardHeader>
            <CardContent>
              <form method="POST" action={projectDeleteApiPath(project.id)} class="flex flex-col gap-4">
                <label class="flex w-fit items-center gap-2 text-sm">
                  <input
                    type="checkbox"
                    name={PROJECT_FIELDS.confirmDelete}
                    value="1"
                    required
                    class="size-4 accent-destructive"
                  />
                  {t.projects.delete.confirm}
                </label>
                <div>
                  <Button type="submit" variant="destructive">
                    {t.projects.delete.submit}
                  </Button>
                </div>
              </form>
            </CardContent>
          </Card>
        </section>
      </div>

      <aside class="flex flex-col gap-4 lg:sticky lg:top-6" aria-label={t.projects.page.summary}>
        <Card className="gap-4 py-4">
          <CardContent className="flex flex-col gap-4 px-4">
            <div class="flex h-80 w-full items-center justify-center">
              {snapshotGeometry?.ok ? (
                <CabinetDrawing
                  geometry={snapshotGeometry.geometry}
                  devices={placedDevices}
                  className="h-full w-full"
                />
              ) : (
                <p class="text-center text-xs text-muted-foreground">{t.projects.cabinet.drawingUnavailable}</p>
              )}
            </div>
            <div class="min-w-0">
              <p class="font-semibold break-words">{project.cabinet_name}</p>
              <p class="text-sm text-muted-foreground">
                {t.projects.cabinet.manufacturerModel(project.cabinet_manufacturer, project.cabinet_model)}
              </p>
            </div>
            <Separator />
            {supply ? (
              <dl class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 text-sm">
                <dt class="text-muted-foreground">{t.projects.page.supplyStatus}</dt>
                <dd>
                  <Badge variant="success">{t.projects.page.supplyConfigured}</Badge>
                </dd>
                <dt class="text-muted-foreground">{t.projects.page.warningsStatus}</dt>
                <dd>
                  <Badge variant={warningMessages.length > 0 ? "warning" : "secondary"}>
                    {t.projects.page.warningCount(warningMessages.length)}
                  </Badge>
                </dd>
              </dl>
            ) : (
              <Alert variant="warning" role={undefined}>
                <TriangleAlertIcon aria-hidden="true" />
                <AlertTitle>{t.projects.page.supplyStatus}</AlertTitle>
                <AlertDescription className="block">
                  {t.projects.page.supplyMissing}{" "}
                  <a href="#supply" class="font-semibold underline underline-offset-4">
                    {t.projects.page.supplyMissingLink}
                  </a>
                </AlertDescription>
              </Alert>
            )}
            <dl class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 text-sm">
              <dt class="text-muted-foreground">{t.projects.page.matchingStatus}</dt>
              <dd>
                <Badge variant={matching.variant}>{matching.text}</Badge>
              </dd>
              <dt class="text-muted-foreground">{t.projects.page.layoutStatus}</dt>
              <dd>
                <Badge variant={layoutStatus.variant}>{layoutStatus.text}</Badge>
              </dd>
              <dt class="text-muted-foreground">{t.projects.page.quoteStatus}</dt>
              <dd>
                <Badge variant={quoteStatus.variant} className="font-mono tabular-nums">
                  {quoteStatus.text}
                </Badge>
              </dd>
            </dl>
          </CardContent>
        </Card>

        <nav aria-label={t.projects.page.sectionNav}>
          <ul class="flex flex-col gap-1 text-sm">
            {sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="block rounded-md px-3 py-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                >
                  {section.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </div>
  )}
</AppLayout>
