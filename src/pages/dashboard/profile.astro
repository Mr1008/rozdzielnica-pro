---
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { t } from "@/lib/i18n";
import { PRICE_INPUT_PATTERN } from "@/lib/price-input";
import { pricingErrorMessage } from "@/lib/pricing-errors";
import {
  MAX_MOUNT_MINUTES,
  MAX_OVERHEAD_MINUTES,
  MIN_MOUNT_MINUTES,
  MIN_OVERHEAD_MINUTES,
  PRICING_API_PATH,
  PRICING_FIELDS,
  pricingFormDefaults,
  type PricingFormDefaults,
} from "@/lib/pricing-profile";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";

// No role check here on purpose: `/dashboard/*` is gated to electricians in
// `src/lib/route-access.ts`, and RLS returns only the caller's own `pricing_profiles` row.
const error = pricingErrorMessage(Astro.url.searchParams.get("error"));
const saved = Astro.url.searchParams.get("saved") === "1" && error === null;

async function loadDefaults(): Promise<{ defaults: PricingFormDefaults | null; loadError: string | null }> {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return { defaults: null, loadError: t.pricingErrors.notConfigured };
  // The route gate guarantees a user; this only keeps `user.id` typed as present.
  const { user } = Astro.locals;
  if (!user) return { defaults: null, loadError: t.pricingProfile.loadFailed };

  const { data, error: queryError } = await supabase
    .from("pricing_profiles")
    .select("hourly_rate_grosze, mount_minutes_per_device, project_overhead_minutes")
    .eq("user_id", user.id)
    .maybeSingle();
  if (queryError) {
    // The SQLSTATE only, never Supabase's message — `wrangler tail` is the only trace a failure leaves.
    // eslint-disable-next-line no-console
    console.error("pricing profile load failed", queryError.code);
    Astro.response.status = 500;
    return { defaults: null, loadError: t.pricingProfile.loadFailed };
  }
  // No row is the "not configured" state: the form starts empty, with no invented defaults.
  return { defaults: pricingFormDefaults(data), loadError: null };
}

const { defaults, loadError } = await loadDefaults();

const inputClass = cn(
  "w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/40",
  "transition-colors focus:ring-2 focus:ring-purple-400 focus:outline-none",
);
const labelClass = "mb-1 block text-xs text-blue-100/80";
const hintClass = "mt-1 text-xs text-blue-100/50";
---

<Layout title={t.pricingProfile.title}>
  {loadError && <Banner variant="error">{loadError}</Banner>}
  {error && <Banner variant="error">{error}</Banner>}
  {saved && <Banner variant="info">{t.pricingProfile.saved}</Banner>}
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <a href="/dashboard" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        {t.pricingProfile.backToDashboard}
      </a>
      <h1 class="mt-2 mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {t.pricingProfile.title}
      </h1>
      <p class="mb-6 text-sm text-blue-100/70">{t.pricingProfile.description}</p>
      {defaults && (
        <form
          method="POST"
          action={PRICING_API_PATH}
          class="flex flex-col gap-5 rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl"
        >
          <div>
            <label for="hourly-rate" class:list={labelClass}>
              {t.pricingProfile.hourlyRateLabel}
            </label>
            <input
              id="hourly-rate"
              name={PRICING_FIELDS.hourlyRate}
              type="text"
              inputmode="decimal"
              autocomplete="off"
              pattern={PRICE_INPUT_PATTERN}
              required
              value={defaults.hourly_rate}
              placeholder={t.pricingProfile.hourlyRatePlaceholder}
              aria-describedby="hourly-rate-hint"
              class:list={inputClass}
            />
            <p id="hourly-rate-hint" class:list={hintClass}>
              {t.pricingProfile.hourlyRateHint}
            </p>
          </div>
          <div>
            <label for="mount-minutes" class:list={labelClass}>
              {t.pricingProfile.mountMinutesLabel}
            </label>
            <input
              id="mount-minutes"
              name={PRICING_FIELDS.mountMinutes}
              type="number"
              inputmode="numeric"
              step="1"
              min={MIN_MOUNT_MINUTES}
              max={MAX_MOUNT_MINUTES}
              required
              value={defaults.mount_minutes_per_device}
              aria-describedby="mount-minutes-hint"
              class:list={inputClass}
            />
            <p id="mount-minutes-hint" class:list={hintClass}>
              {t.pricingProfile.mountMinutesHint(MIN_MOUNT_MINUTES, MAX_MOUNT_MINUTES)}
            </p>
          </div>
          <div>
            <label for="overhead-minutes" class:list={labelClass}>
              {t.pricingProfile.overheadMinutesLabel}
            </label>
            <input
              id="overhead-minutes"
              name={PRICING_FIELDS.overheadMinutes}
              type="number"
              inputmode="numeric"
              step="1"
              min={MIN_OVERHEAD_MINUTES}
              max={MAX_OVERHEAD_MINUTES}
              required
              value={defaults.project_overhead_minutes}
              aria-describedby="overhead-minutes-hint"
              class:list={inputClass}
            />
            <p id="overhead-minutes-hint" class:list={hintClass}>
              {t.pricingProfile.overheadMinutesHint(MIN_OVERHEAD_MINUTES, MAX_OVERHEAD_MINUTES)}
            </p>
          </div>
          <div>
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              {t.pricingProfile.save}
            </button>
          </div>
        </form>
      )}
    </div>
  </div>
</Layout>
