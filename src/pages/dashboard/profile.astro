---
import Banner from "@/components/Banner.astro";
import PageHeader from "@/components/PageHeader.astro";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { Field, FieldDescription, FieldLabel } from "@/components/ui/field";
import { InputGroup, InputGroupAddon, InputGroupInput, InputGroupText } from "@/components/ui/input-group";
import AppLayout from "@/layouts/AppLayout.astro";
import { fieldControlProps, fieldHintId } from "@/lib/field-a11y";
import { t } from "@/lib/i18n";
import { PRICE_INPUT_PATTERN } from "@/lib/price-input";
import { pricingErrorMessage } from "@/lib/pricing-errors";
import {
  MAX_MOUNT_MINUTES,
  MAX_OVERHEAD_MINUTES,
  MIN_MOUNT_MINUTES,
  MIN_OVERHEAD_MINUTES,
  PRICING_API_PATH,
  PRICING_FIELDS,
  pricingFormDefaults,
  type PricingFormDefaults,
} from "@/lib/pricing-profile";
import { createClient } from "@/lib/supabase";

// No role check here on purpose: `/dashboard/*` is gated to electricians in
// `src/lib/route-access.ts`, and RLS returns only the caller's own `pricing_profiles` row.
const error = pricingErrorMessage(Astro.url.searchParams.get("error"));
const saved = Astro.url.searchParams.get("saved") === "1" && error === null;

async function loadDefaults(): Promise<{ defaults: PricingFormDefaults | null; loadError: string | null }> {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return { defaults: null, loadError: t.pricingErrors.notConfigured };
  // The route gate guarantees a user; this only keeps `user.id` typed as present.
  const { user } = Astro.locals;
  if (!user) return { defaults: null, loadError: t.pricingProfile.loadFailed };

  const { data, error: queryError } = await supabase
    .from("pricing_profiles")
    .select("hourly_rate_grosze, mount_minutes_per_device, project_overhead_minutes")
    .eq("user_id", user.id)
    .maybeSingle();
  if (queryError) {
    // The SQLSTATE only, never Supabase's message — `wrangler tail` is the only trace a failure leaves.
    // eslint-disable-next-line no-console
    console.error("pricing profile load failed", queryError.code);
    Astro.response.status = 500;
    return { defaults: null, loadError: t.pricingProfile.loadFailed };
  }
  // No row is the "not configured" state: the form starts empty, with no invented defaults.
  return { defaults: pricingFormDefaults(data), loadError: null };
}

const { defaults, loadError } = await loadDefaults();

const fields = [
  {
    id: "hourly-rate",
    label: t.pricingProfile.hourlyRateLabel,
    hint: t.pricingProfile.hourlyRateHint,
    unit: t.pricingProfile.hourlyRateUnit,
  },
  {
    id: "mount-minutes",
    label: t.pricingProfile.mountMinutesLabel,
    hint: t.pricingProfile.mountMinutesHint(MIN_MOUNT_MINUTES, MAX_MOUNT_MINUTES),
    unit: t.pricingProfile.minutesUnit,
  },
  {
    id: "overhead-minutes",
    label: t.pricingProfile.overheadMinutesLabel,
    hint: t.pricingProfile.overheadMinutesHint(MIN_OVERHEAD_MINUTES, MAX_OVERHEAD_MINUTES),
    unit: t.pricingProfile.minutesUnit,
  },
] as const;
const [rateField, mountField, overheadField] = fields;

// Each value carries its unit as an inline-end addon of the registry `InputGroup`.
const inputClass = "font-mono";
---

<AppLayout title={t.pricingProfile.title}>
  {loadError && (
    <Banner slot="banners" variant="error">
      {loadError}
    </Banner>
  )}
  {error && (
    <Banner slot="banners" variant="error">
      {error}
    </Banner>
  )}
  {saved && (
    <Banner slot="banners" variant="success">
      {t.pricingProfile.saved}
    </Banner>
  )}

  <PageHeader
    title={t.pricingProfile.title}
    backHref="/dashboard"
    backLabel={t.pricingProfile.backToDashboard}
    description={t.pricingProfile.description}
  />

  {defaults && (
    <Card className="max-w-2xl">
      <CardContent>
        <form method="POST" action={PRICING_API_PATH} class="flex flex-col gap-5">
          <Field>
            <FieldLabel htmlFor={rateField.id}>{rateField.label}</FieldLabel>
            <InputGroup>
              <InputGroupInput
                name={PRICING_FIELDS.hourlyRate}
                type="text"
                inputMode="decimal"
                autoComplete="off"
                pattern={PRICE_INPUT_PATTERN}
                required
                defaultValue={defaults.hourly_rate}
                placeholder={t.pricingProfile.hourlyRatePlaceholder}
                className={inputClass}
                {...fieldControlProps(rateField.id, { hint: rateField.hint })}
              />
              <InputGroupAddon align="inline-end" aria-hidden="true">
                <InputGroupText className="font-mono">{rateField.unit}</InputGroupText>
              </InputGroupAddon>
            </InputGroup>
            <FieldDescription id={fieldHintId(rateField.id)}>{rateField.hint}</FieldDescription>
          </Field>
          <div class="grid items-start gap-5 sm:grid-cols-2">
            <Field>
              <FieldLabel htmlFor={mountField.id}>{mountField.label}</FieldLabel>
              <InputGroup>
                <InputGroupInput
                  name={PRICING_FIELDS.mountMinutes}
                  type="number"
                  inputMode="numeric"
                  step="1"
                  min={MIN_MOUNT_MINUTES}
                  max={MAX_MOUNT_MINUTES}
                  required
                  defaultValue={defaults.mount_minutes_per_device}
                  className={inputClass}
                  {...fieldControlProps(mountField.id, { hint: mountField.hint })}
                />
                <InputGroupAddon align="inline-end" aria-hidden="true">
                  <InputGroupText className="font-mono">{mountField.unit}</InputGroupText>
                </InputGroupAddon>
              </InputGroup>
              <FieldDescription id={fieldHintId(mountField.id)}>{mountField.hint}</FieldDescription>
            </Field>
            <Field>
              <FieldLabel htmlFor={overheadField.id}>{overheadField.label}</FieldLabel>
              <InputGroup>
                <InputGroupInput
                  name={PRICING_FIELDS.overheadMinutes}
                  type="number"
                  inputMode="numeric"
                  step="1"
                  min={MIN_OVERHEAD_MINUTES}
                  max={MAX_OVERHEAD_MINUTES}
                  required
                  defaultValue={defaults.project_overhead_minutes}
                  className={inputClass}
                  {...fieldControlProps(overheadField.id, { hint: overheadField.hint })}
                />
                <InputGroupAddon align="inline-end" aria-hidden="true">
                  <InputGroupText className="font-mono">{overheadField.unit}</InputGroupText>
                </InputGroupAddon>
              </InputGroup>
              <FieldDescription id={fieldHintId(overheadField.id)}>{overheadField.hint}</FieldDescription>
            </Field>
          </div>
          <div>
            <Button type="submit">{t.pricingProfile.save}</Button>
          </div>
        </form>
      </CardContent>
    </Card>
  )}
</AppLayout>
