---
import Banner from "@/components/Banner.astro";
import PageHeader from "@/components/PageHeader.astro";
import DeviceCatalogList from "@/components/devices/DeviceCatalogList.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import AppLayout from "@/layouts/AppLayout.astro";
import { NEW_DEVICE_PATH } from "@/lib/device-catalog";
import { deviceErrorMessage } from "@/lib/device-errors";
import { t } from "@/lib/i18n";
import { ROLE_HOME } from "@/lib/route-access";
import { logServerError } from "@/lib/server-log";
import { createClient } from "@/lib/supabase";
import { PlusIcon } from "lucide-react";

// No role check here on purpose: `/admin/*` is gated in `src/lib/route-access.ts`, and RLS lets an
// admin read every device, archived ones included.
const actionError = deviceErrorMessage(Astro.url.searchParams.get("error"));

async function loadDevices() {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  // `createClient()` is null when the Supabase env vars are unset; the middleware would already have
  // sent an anonymous visitor to sign in, but the branch must still render something sane.
  if (!supabase) return { rows: [], loadError: t.deviceErrors.notConfigured };

  const { data, error } = await supabase
    .from("devices")
    .select(
      "id, kind, name, manufacturer, model, price_grosze, width_mm, height_mm, depth_mm, poles, rated_current_a, residual_current_ma, rcd_type, breaking_capacity_ka, terminal_groups, n_terminal_side, archived_at",
    );
  if (error) {
    logServerError("devices list load failed", error, { userId: Astro.locals.user?.id });
    Astro.response.status = 500;
    return { rows: [], loadError: t.devices.catalog.loadFailed };
  }
  return { rows: data, loadError: null };
}

const { rows, loadError } = await loadDevices();
---

<AppLayout title={t.devices.catalog.title} width="wide">
  {actionError && (
    <Banner slot="banners" variant="error">
      {actionError}
    </Banner>
  )}
  {loadError && (
    <Banner slot="banners" variant="error">
      {loadError}
    </Banner>
  )}

  <PageHeader
    title={t.devices.catalog.title}
    backHref={ROLE_HOME.admin}
    backLabel={t.devices.catalog.backToAdmin}
    description={t.devices.catalog.description}
  >
    <a slot="actions" href={NEW_DEVICE_PATH} class:list={buttonVariants()}>
      <PlusIcon aria-hidden="true" />
      {t.devices.catalog.newDevice}
    </a>
  </PageHeader>

  {!loadError && rows.length === 0 && (
    <Card className="items-center border-dashed text-center shadow-none">
      <CardContent className="flex flex-col items-center gap-4">
        <p class="max-w-md text-muted-foreground">{t.devices.catalog.empty}</p>
        <a href={NEW_DEVICE_PATH} class:list={buttonVariants()}>
          <PlusIcon aria-hidden="true" />
          {t.devices.catalog.newDevice}
        </a>
      </CardContent>
    </Card>
  )}

  {/* An empty catalog says so once; the per-kind sections only appear once there is something to
      group, and then an empty kind is a visible catalog gap. */}
  {!loadError && rows.length > 0 && <DeviceCatalogList devices={rows} idPrefix="devices" />}
</AppLayout>
