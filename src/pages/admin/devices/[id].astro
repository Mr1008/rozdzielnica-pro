---
import Banner from "@/components/Banner.astro";
import PageHeader from "@/components/PageHeader.astro";
import DeviceEditor from "@/components/devices/DeviceEditor";
import { Card, CardContent } from "@/components/ui/card";
import AppLayout from "@/layouts/AppLayout.astro";
import { isUuid } from "@/lib/catalog";
import { DEVICES_PATH, deviceApiPath } from "@/lib/device-catalog";
import { deviceErrorMessage } from "@/lib/device-errors";
import type { DeviceRow } from "@/lib/device-form";
import { t } from "@/lib/i18n";
import { createClient } from "@/lib/supabase";

// No role check here on purpose: `/admin/*` is gated in `src/lib/route-access.ts`, and RLS lets an
// admin read every device, archived ones included.
const { id } = Astro.params;
const error = deviceErrorMessage(Astro.url.searchParams.get("error")) ?? undefined;

async function loadDevice(): Promise<{ row: DeviceRow | null; loadError: string | null }> {
  // Checked before querying: a non-UUID would reach PostgREST as `22P02` and read as a failure,
  // when it is simply a device that does not exist.
  if (!isUuid(id)) return { row: null, loadError: null };

  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return { row: null, loadError: t.deviceErrors.notConfigured };

  const { data, error: queryError } = await supabase
    .from("devices")
    .select(
      "id, kind, name, manufacturer, model, price_grosze, width_mm, height_mm, depth_mm, poles, rated_current_a, residual_current_ma, rcd_type, breaking_capacity_ka, terminal_groups, n_terminal_side",
    )
    .eq("id", id)
    .maybeSingle();
  if (queryError) {
    // The SQLSTATE only, never Supabase's message — `wrangler tail` is the only trace a failure leaves.
    // eslint-disable-next-line no-console
    console.error("device load failed", queryError.code);
    Astro.response.status = 500;
    return { row: null, loadError: t.devices.editor.loadFailed };
  }
  return { row: data, loadError: null };
}

const { row, loadError } = await loadDevice();
if (!row && !loadError) Astro.response.status = 404;

const title = row ? t.devices.editor.editTitle : t.devices.editor.notFoundTitle;
---

<AppLayout title={title} width="wide">
  {loadError && (
    <Banner slot="banners" variant="error">
      {loadError}
    </Banner>
  )}
  <PageHeader
    title={row ? t.devices.editor.editTitleFor(row.name) : title}
    backHref={DEVICES_PATH}
    backLabel={t.devices.editor.backToCatalog}
  />
  {row ? (
    // `client:only`: the editor restores a rejected draft from sessionStorage on its first render.
    <DeviceEditor initial={row} action={deviceApiPath(row.id)} error={error} client:only="react" />
  ) : (
    !loadError && (
      <Card className="items-center border-dashed text-center shadow-none">
        <CardContent>
          <p class="text-muted-foreground">{t.deviceErrors.notFound}</p>
        </CardContent>
      </Card>
    )
  )}
</AppLayout>
