---
import PageHeader from "@/components/PageHeader.astro";
import DeviceEditor from "@/components/devices/DeviceEditor";
import AppLayout from "@/layouts/AppLayout.astro";
import { DEVICES_API_PATH, DEVICES_PATH } from "@/lib/device-catalog";
import { deviceErrorMessage } from "@/lib/device-errors";
import { t } from "@/lib/i18n";

// No role check here on purpose: `/admin/*` is gated in `src/lib/route-access.ts`.
const error = deviceErrorMessage(Astro.url.searchParams.get("error")) ?? undefined;
---

<AppLayout title={t.devices.editor.newTitle} width="wide">
  <PageHeader title={t.devices.editor.newTitle} backHref={DEVICES_PATH} backLabel={t.devices.editor.backToCatalog} />
  {/* `client:only`: the editor restores a rejected draft from sessionStorage on its first render. */}
  <DeviceEditor action={DEVICES_API_PATH} error={error} client:only="react" />
</AppLayout>
