---
import PageHeader from "@/components/PageHeader.astro";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import AppLayout from "@/layouts/AppLayout.astro";
import { CABINETS_PATH } from "@/lib/cabinet-catalog";
import { DEVICES_PATH } from "@/lib/device-catalog";
import { t } from "@/lib/i18n";
import { ChevronRightIcon, CpuIcon, PanelsTopLeftIcon } from "lucide-react";

// No role check here on purpose: `/admin` is gated in `src/lib/route-access.ts`, which the
// middleware applies to every request. This is the catalog hub.
const { user } = Astro.locals;

const destinations = [
  {
    href: CABINETS_PATH,
    icon: PanelsTopLeftIcon,
    title: t.admin.cabinetCatalogLink,
    description: t.admin.cabinetCatalogDescription,
  },
  {
    href: DEVICES_PATH,
    icon: CpuIcon,
    title: t.admin.deviceCatalogLink,
    description: t.admin.deviceCatalogDescription,
  },
];
---

<AppLayout title={t.admin.title}>
  <PageHeader
    title={user?.email ? t.dashboard.greetingTitle(user.email) : t.admin.title}
    description={t.admin.description}
  />

  <nav aria-label={t.admin.destinationsLabel}>
    <ul class="grid gap-4 md:grid-cols-2">
      {destinations.map(({ href, icon: Icon, title, description }) => (
        <li>
          <a href={href} class="group block h-full rounded-xl">
            <Card className="h-full flex-row items-center gap-4 px-6 transition-colors group-hover:border-primary/60 group-hover:bg-accent">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon className="size-6" aria-hidden="true" />
              </span>
              <CardHeader className="flex-1 px-0">
                <CardTitle className="text-lg">{title}</CardTitle>
                <CardDescription>{description}</CardDescription>
              </CardHeader>
              <ChevronRightIcon
                className="size-5 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </Card>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</AppLayout>
