---
import Banner from "@/components/Banner.astro";
import PageHeader from "@/components/PageHeader.astro";
import CabinetCatalogList from "@/components/cabinets/CabinetCatalogList.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import AppLayout from "@/layouts/AppLayout.astro";
import { NEW_CABINET_PATH } from "@/lib/cabinet-catalog";
import { cabinetErrorMessage } from "@/lib/cabinet-errors";
import { parseCabinetGeometry } from "@/lib/cabinet-geometry";
import { toCatalogMounting } from "@/lib/catalog-list";
import { t } from "@/lib/i18n";
import { ROLE_HOME } from "@/lib/route-access";
import { logServerError } from "@/lib/server-log";
import { createClient } from "@/lib/supabase";
import { PlusIcon } from "lucide-react";

// No role check here on purpose: `/admin/*` is gated in `src/lib/route-access.ts`, and RLS lets an
// admin read every cabinet, archived ones included.
const actionError = cabinetErrorMessage(Astro.url.searchParams.get("error"));

async function loadCabinets() {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  // `createClient()` is null when the Supabase env vars are unset; the middleware would already have
  // sent an anonymous visitor to sign in, but the branch must still render something sane.
  if (!supabase) return { rows: [], loadError: t.cabinetErrors.notConfigured };

  const { data, error } = await supabase
    .from("cabinets")
    .select("id, name, manufacturer, model, mounting, price_grosze, geometry, archived_at");
  if (error) {
    logServerError("cabinets list load failed", error, { userId: Astro.locals.user?.id });
    Astro.response.status = 500;
    return { rows: [], loadError: t.cabinets.catalog.loadFailed };
  }
  return { rows: data, loadError: null };
}

const { rows, loadError } = await loadCabinets();

// A stored row that no longer parses is listed with a warning instead of a drawing, so the admin can
// still open, fix or archive it — one bad row must not take the whole catalog down.
const cabinets = rows.map(({ geometry, mounting, ...row }) => {
  const parsed = parseCabinetGeometry(geometry);
  return { ...row, mounting: toCatalogMounting(mounting), geometry: parsed.ok ? parsed.geometry : null };
});
---

<AppLayout title={t.cabinets.catalog.title}>
  {actionError && (
    <Banner slot="banners" variant="error">
      {actionError}
    </Banner>
  )}
  {loadError && (
    <Banner slot="banners" variant="error">
      {loadError}
    </Banner>
  )}

  <PageHeader
    title={t.cabinets.catalog.title}
    backHref={ROLE_HOME.admin}
    backLabel={t.cabinets.catalog.backToAdmin}
    description={t.cabinets.catalog.description}
  >
    <a slot="actions" href={NEW_CABINET_PATH} class:list={buttonVariants()}>
      <PlusIcon aria-hidden="true" />
      {t.cabinets.catalog.newCabinet}
    </a>
  </PageHeader>

  {!loadError && cabinets.length === 0 && (
    <Card className="items-center border-dashed text-center shadow-none">
      <CardContent className="flex flex-col items-center gap-4">
        <p class="max-w-md text-muted-foreground">{t.cabinets.catalog.empty}</p>
        <a href={NEW_CABINET_PATH} class:list={buttonVariants()}>
          <PlusIcon aria-hidden="true" />
          {t.cabinets.catalog.newCabinet}
        </a>
      </CardContent>
    </Card>
  )}

  {cabinets.length > 0 && <CabinetCatalogList mode="admin" cabinets={cabinets} idPrefix="admin-cabinet" />}
</AppLayout>
