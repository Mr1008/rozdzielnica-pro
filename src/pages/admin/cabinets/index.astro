---
import Banner from "@/components/Banner.astro";
import PageHeader from "@/components/PageHeader.astro";
import { CabinetDrawing } from "@/components/cabinets/CabinetDrawing";
import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import AppLayout from "@/layouts/AppLayout.astro";
import { NEW_CABINET_PATH, cabinetArchivePath, cabinetEditPath, cabinetRestorePath } from "@/lib/cabinet-catalog";
import { cabinetErrorMessage } from "@/lib/cabinet-errors";
import { sortForCatalogList } from "@/lib/catalog";
import { parseCabinetGeometry } from "@/lib/cabinet-geometry";
import { formatMoney, t } from "@/lib/i18n";
import { ROLE_HOME } from "@/lib/route-access";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";
import { PlusIcon } from "lucide-react";

// No role check here on purpose: `/admin/*` is gated in `src/lib/route-access.ts`, and RLS lets an
// admin read every cabinet, archived ones included.
const actionError = cabinetErrorMessage(Astro.url.searchParams.get("error"));

async function loadCabinets() {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  // `createClient()` is null when the Supabase env vars are unset; the middleware would already have
  // sent an anonymous visitor to sign in, but the branch must still render something sane.
  if (!supabase) return { rows: [], loadError: t.cabinetErrors.notConfigured };

  const { data, error } = await supabase
    .from("cabinets")
    .select("id, name, manufacturer, model, price_grosze, geometry, archived_at");
  if (error) {
    // The SQLSTATE only, never Supabase's message — `wrangler tail` is the only trace a failure leaves.
    // eslint-disable-next-line no-console
    console.error("cabinets list load failed", error.code);
    Astro.response.status = 500;
    return { rows: [], loadError: t.cabinets.catalog.loadFailed };
  }
  return { rows: sortForCatalogList(data), loadError: null };
}

const { rows, loadError } = await loadCabinets();

// A stored row that no longer parses is listed with a warning instead of a drawing, so the admin can
// still open, fix or archive it — one bad row must not take the whole catalog down.
const cabinets = rows.map((row) => ({ ...row, parsed: parseCabinetGeometry(row.geometry) }));

const rowButtonClass = buttonVariants({ variant: "outline", size: "sm" });
---

<AppLayout title={t.cabinets.catalog.title}>
  {actionError && (
    <Banner slot="banners" variant="error">
      {actionError}
    </Banner>
  )}
  {loadError && (
    <Banner slot="banners" variant="error">
      {loadError}
    </Banner>
  )}

  <PageHeader
    title={t.cabinets.catalog.title}
    backHref={ROLE_HOME.admin}
    backLabel={t.cabinets.catalog.backToAdmin}
    description={t.cabinets.catalog.description}
  >
    <a slot="actions" href={NEW_CABINET_PATH} class:list={buttonVariants()}>
      <PlusIcon aria-hidden="true" />
      {t.cabinets.catalog.newCabinet}
    </a>
  </PageHeader>

  {!loadError && cabinets.length === 0 && (
    <Card className="items-center border-dashed text-center shadow-none">
      <CardContent className="flex flex-col items-center gap-4">
        <p class="max-w-md text-muted-foreground">{t.cabinets.catalog.empty}</p>
        <a href={NEW_CABINET_PATH} class:list={buttonVariants()}>
          <PlusIcon aria-hidden="true" />
          {t.cabinets.catalog.newCabinet}
        </a>
      </CardContent>
    </Card>
  )}

  <ul class="flex flex-col gap-4">
    {cabinets.map((cabinet) => {
      const archived = cabinet.archived_at !== null;
      return (
        <li>
          <Card
            className={cn(
              "flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center",
              archived && "border-dashed bg-muted/40",
            )}
          >
            <div
              class:list={[
                "flex h-40 w-40 shrink-0 items-center justify-center rounded-md border bg-background p-2",
                archived && "opacity-70",
              ]}
            >
              {cabinet.parsed.ok ? (
                <CabinetDrawing geometry={cabinet.parsed.geometry} className="h-full w-full" />
              ) : (
                <p class="text-center text-xs text-destructive">{t.cabinets.catalog.invalidStoredGeometry}</p>
              )}
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-lg font-semibold">{cabinet.name}</h2>
                {archived && <Badge variant="warning">{t.cabinets.catalog.archivedBadge}</Badge>}
              </div>
              <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                <dt class="text-muted-foreground">{t.cabinets.fields.manufacturer}</dt>
                <dd>{cabinet.manufacturer}</dd>
                <dt class="text-muted-foreground">{t.cabinets.fields.model}</dt>
                <dd class="font-mono">{cabinet.model}</dd>
                <dt class="text-muted-foreground">{t.cabinets.fields.price}</dt>
                <dd class="font-mono tabular-nums">{formatMoney(cabinet.price_grosze / 100)}</dd>
                {cabinet.parsed.ok && (
                  <>
                    <dt class="text-muted-foreground">{t.cabinets.interior}</dt>
                    <dd class="font-mono tabular-nums">
                      {t.cabinets.catalog.dimensions(
                        cabinet.parsed.geometry.interior.widthMm,
                        cabinet.parsed.geometry.interior.heightMm,
                        cabinet.parsed.geometry.interior.depthMm,
                      )}
                    </dd>
                  </>
                )}
              </dl>
            </div>

            <div class="flex shrink-0 gap-2 sm:flex-col">
              <a href={cabinetEditPath(cabinet.id)} class:list={rowButtonClass}>
                {t.cabinets.catalog.edit}
              </a>
              <form method="POST" action={archived ? cabinetRestorePath(cabinet.id) : cabinetArchivePath(cabinet.id)}>
                <Button type="submit" variant="outline" size="sm" className="w-full">
                  {archived ? t.cabinets.catalog.restore : t.cabinets.catalog.archive}
                </Button>
              </form>
            </div>
          </Card>
        </li>
      );
    })}
  </ul>
</AppLayout>
