---
import PageHeader from "@/components/PageHeader.astro";
import CabinetEditor from "@/components/cabinets/CabinetEditor";
import AppLayout from "@/layouts/AppLayout.astro";
import { CABINETS_API_PATH, CABINETS_PATH } from "@/lib/cabinet-catalog";
import { cabinetErrorMessage } from "@/lib/cabinet-errors";
import { t } from "@/lib/i18n";

// No role check here on purpose: `/admin/*` is gated in `src/lib/route-access.ts`.
const error = cabinetErrorMessage(Astro.url.searchParams.get("error")) ?? undefined;
---

<AppLayout title={t.cabinets.editor.newTitle} width="wide">
  <PageHeader title={t.cabinets.editor.newTitle} backHref={CABINETS_PATH} backLabel={t.cabinets.editor.backToCatalog} />
  {/* `client:only`: the editor restores a rejected draft from sessionStorage on its first render. */}
  <CabinetEditor action={CABINETS_API_PATH} error={error} client:only="react" />
</AppLayout>
